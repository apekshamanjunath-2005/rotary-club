# ==============================================================================
# Rotary Club of Honavar - Environment Variables Configuration Template
# Copy this file to '.env' for local development.
# For Vercel Production, configure these under: Project Settings -> Environment Variables.
# NEVER commit real secret values to GitHub.
# ==============================================================================

# Server Port (Local development default: 5000; Vercel automatically manages port in production)
PORT=5000

# ==================== PRIMARY DATABASE (Turso Cloud) ====================
# The Turso Cloud database URL (AWS ap-south-1 Mumbai region)
# Format: libsql://<database-name>-<org-name>.aws-ap-south-1.turso.io
TURSO_DATABASE_URL=libsql://rotary-honavar-rotary-club.aws-ap-south-1.turso.io

# Turso Database Authentication Token
# Obtain from Turso CLI ('turso db tokens create rotary-honavar') or Turso Web Dashboard
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# (Optional Local Fallback only for offline testing - leave commented out in production)
# TURSO_DATABASE_URL=file:./data/rotary.db
# TURSO_AUTH_TOKEN=

# ==================== AUTHENTICATION & SECURITY ====================
# Strong, high-entropy secret key used to sign JWT sessions (change in production!)
JWT_SECRET=your_jwt_secret_key_change_in_production

# ==================== FILE STORAGE (Vercel Blob) ====================
# Vercel Blob read-write token for uploading project covers and event photo galleries
# Format: vercel_blob_rw_************************
BLOB_READ_WRITE_TOKEN=your_vercel_blob_rw_token_here

# (Optional) Vercel Blob Store ID
BLOB_STORE_ID=your_vercel_blob_store_id_here
